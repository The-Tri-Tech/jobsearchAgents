# Database Connection (SQLite - file-based, no server needed)
APP_ENV=development
LLM_PROVIDER=openai
DATABASE_URL=sqlite:///./jobsearch.db

# JWT Secret Key
SECRET_KEY=skillbridge_super_secret_jwt_key_2026_change_in_production

# Gemini API (create a key in Google AI Studio)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=180
JOB_MATCH_TIMEOUT_SECONDS=25

# OpenAI API (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=25
